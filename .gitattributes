# 统一换行符：让 Windows / macOS / Linux 上克隆下来的一致，diff 也干净
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.csv   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Windows 批处理必须用 CRLF，否则可能执行异常
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.xlsx  binary
*.zip   binary

